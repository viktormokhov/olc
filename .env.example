# Copy to .env and edit before first start: cp .env.example .env
# Or run ./install.sh — it will prompt for ports and create .env

# Public DNS name for the panel (must point to your server IP)
PANEL_DOMAIN=panel.example.com

# Let's Encrypt contact email
ACME_EMAIL=admin@example.com

# API JWT secret — generate: openssl rand -hex 32
SECRET_KEY=change-me-use-openssl-rand-hex-32

# Access ports (install.sh can set these; open in firewall)
PANEL_PORT=808
OLCRTC_SRV_PORT=8801

# Host path for instance data (users, YAML configs)
HOST_DATA_DIR=./backend/data

# olcrtc image tag built by compose
OLCRTC_IMAGE=olcrtc:patched
# Upstream branch (default master; old refactor/universal-carrier was removed)
# OLCRTC_BRANCH=master
# OLCRTC_REPO=https://github.com/openlibrecommunity/olcrtc.git

# Bootstrap: upstream OlcPanel if backend/ missing (usually already in this repo)
# OLCPANEL_REPO=https://github.com/OpenLibreCommunity/OlcPanel.git
# OLCPANEL_BRANCH=main
